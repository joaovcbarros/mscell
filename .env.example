# Copie este arquivo para ".env" e ajuste os valores.
# O ".env" real nunca deve ser commitado (ja esta no .gitignore).

DB_HOST=localhost
DB_PORT=3306
DB_NAME=mscell
DB_USER=mscell_app
DB_PASS=troque-por-uma-senha-forte
DB_SOCKET=C:/laragon/tmp/mysql.sock

APP_SESSION_NAME=mscell_session
APP_TIMEZONE=America/Sao_Paulo

# Token secreto compartilhado com TODAS as pontes Node (whatsapp-bridge),
# uma por loja. Gere um valor aleatorio proprio antes de usar em producao.
# Os numeros autorizados NAO ficam mais aqui: cada loja tem o seu proprio
# numero cadastrado em Lojas > numero de WhatsApp (tela do sistema).
WHATSAPP_WEBHOOK_TOKEN=troque-este-token-por-um-valor-aleatorio
