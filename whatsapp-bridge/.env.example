# Copie para ".env" nesta mesma pasta.

# URL do endpoint PHP (public/api/whatsapp_webhook.php).
# Ajuste a porta/host conforme onde o site estiver rodando.
WEBHOOK_URL=http://localhost:8000/api/whatsapp_webhook.php

# Deve ser IDÊNTICO ao WHATSAPP_WEBHOOK_TOKEN do .env da raiz do projeto.
WEBHOOK_TOKEN=troque-este-token-por-um-valor-aleatorio
